# LLM provider for planning / re-ranking / built-in agent: "openai" | "anthropic"
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Shopify Global Catalog MCP. The public example agent profile works without credentials today;
# Dev Dashboard client credentials are optional insurance.
SHOPIFY_UCP_AGENT_PROFILE=https://outfitter.skulora.com/ucp/agent-profile.json  # self-hosted copy of Shopify's example profile (public/ucp/); Catalog fetches it live
SHOPIFY_CATALOG_CLIENT_ID=
SHOPIFY_CATALOG_CLIENT_SECRET=

# Cloudflare token with Zone→DNS→Edit on skulora.com (used by scripts/dns-vercel.sh only)
CLOUDFLARE_API_TOKEN=

# Per-IP rate limit (60 s window): RATE_LIMIT=off disables; per-bucket overrides below (defaults shown)
RATE_LIMIT=on
RATE_LIMIT_AGENT=60
RATE_LIMIT_ACTIONS=150
RATE_LIMIT_MISSIONS=20
# Built-in-agent model steps per day across ALL callers, so nobody can spend the OpenAI key one
# address at a time. When it trips the board still works through WebMCP (the agent brings its own
# tokens). 0 or blank disables the daily ceiling.
RATE_LIMIT_AGENT_DAY=3000
