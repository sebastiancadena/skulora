# LLM provider for planning / re-ranking / built-in agent: "openai" | "anthropic"
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Shopify Global Catalog MCP. The public example agent profile works without credentials today;
# Dev Dashboard client credentials are optional insurance.
SHOPIFY_UCP_AGENT_PROFILE=https://outfitter.skulora.com/ucp/agent-profile.json  # self-hosted copy of Shopify's example profile (public/ucp/); Catalog fetches it live
SHOPIFY_CATALOG_CLIENT_ID=
SHOPIFY_CATALOG_CLIENT_SECRET=

# Cloudflare token with Zone→DNS→Edit on skulora.com (used by scripts/dns-vercel.sh only)
CLOUDFLARE_API_TOKEN=

# Per-IP rate limit (60 s window): RATE_LIMIT=off disables; per-bucket overrides below (defaults shown)
RATE_LIMIT=on
RATE_LIMIT_AGENT=60
RATE_LIMIT_ACTIONS=150
RATE_LIMIT_MISSIONS=20
# Daily ceilings on the work that spends the OpenAI key, per address and across all callers, so a
# patient caller cannot run up the bill under the per-minute limits. Sizing: a full mission is ~10
# agent steps and ~10 LLM-spending actions (plan, search, explain), so 800/120 is ~80 missions a day
# overall and ~12 from one address. The actions ceiling matters even when nobody uses the built-in
# panel: planning, re-ranking and tradeoffs run on this key whoever drives the board, ChatGPT
# included. Human board edits (lock, reject, choose) are never counted or refused. 0 disables.
RATE_LIMIT_AGENT_DAY=800
RATE_LIMIT_AGENT_IP_DAY=120
RATE_LIMIT_ACTIONS_DAY=800
RATE_LIMIT_ACTIONS_IP_DAY=120
